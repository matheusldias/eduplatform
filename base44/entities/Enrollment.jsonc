{
  "name": "Enrollment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio"
    },
    "user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio"
    },
    "course_id": {
      "type": "string",
      "description": "ID do curso"
    },
    "course_title": {
      "type": "string",
      "description": "T\u00edtulo do curso"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "suspended"
      ],
      "default": "active"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Progresso geral do curso"
    },
    "completed_lessons": {
      "type": "number",
      "default": 0
    },
    "total_lessons": {
      "type": "number",
      "default": 0
    },
    "last_watched_lesson_id": {
      "type": "string",
      "description": "\u00daltima aula assistida"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de conclus\u00e3o"
    }
  },
  "required": [
    "user_id",
    "course_id"
  ]
}