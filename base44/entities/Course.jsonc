{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do curso"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o completa do curso"
    },
    "cover_url": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "instructor_id": {
      "type": "string",
      "description": "ID do instrutor respons\u00e1vel"
    },
    "instructor_name": {
      "type": "string",
      "description": "Nome do instrutor"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Status do curso"
    },
    "total_duration_minutes": {
      "type": "number",
      "default": 0,
      "description": "Dura\u00e7\u00e3o total em minutos"
    },
    "total_lessons": {
      "type": "number",
      "default": 0,
      "description": "Total de aulas"
    },
    "category": {
      "type": "string",
      "description": "Categoria do curso"
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "beginner"
    }
  },
  "required": [
    "title"
  ]
}